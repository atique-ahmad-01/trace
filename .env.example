# =============================================================================
# TRACE configuration. Copy to .env (project root) and adjust.
# Every setting has a working local default; values below show the options.
# =============================================================================

# --- Application -------------------------------------------------------------
ENVIRONMENT=development            # development | production | test
DEBUG=false
LOG_LEVEL=INFO

# --- Security (REQUIRED in production; startup fails with the dev defaults) ---
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
JWT_EXPIRATION_MINUTES=720
# Optional Fernet key for encrypting stored credentials (derived from SECRET_KEY if unset)
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=300

# --- Database ----------------------------------------------------------------
# Local default: SQLite file at backend/trace.db
# DATABASE_URL=sqlite+aiosqlite:///./trace.db
# PostgreSQL (docker compose sets this automatically):
# DATABASE_URL=postgresql+asyncpg://trace:trace@localhost:5432/trace

# --- Background jobs ---------------------------------------------------------
# Set to use RQ workers; unset/unreachable => in-process job runner.
# REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=trace
JOB_TIMEOUT_SECONDS=1800

# --- GitHub ------------------------------------------------------------------
# GitHub App (recommended): repository access via installation tokens + webhooks
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=          # path to the App's .pem private key
GITHUB_WEBHOOK_SECRET=                # webhooks are rejected while unset
# Optional fallback token (public API rate limits, advisories). Org tokens are set in Settings -> Integrations.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# --- Integrations --------------------------------------------------------------
# Model provider, GitHub token and Langfuse are connected per organization in the UI
# (Settings -> Integrations). The variables below in those sections are only a fallback for
# organizations that have not configured their own. Fallback default: on, except
# ENVIRONMENT=production, where everything must be set up in the UI.
# INTEGRATIONS_ENV_FALLBACK=true

# --- Model providers (env fallback) -----------------------------------------
MODEL_PROVIDER=ollama                 # ollama | openai_compatible | anthropic | none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# vLLM or any OpenAI-compatible /v1 endpoint
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# Hosted provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Repository source code is never sent to hosted providers unless this is true
ALLOW_SOURCE_TO_HOSTED_LLM=false
LLM_TIMEOUT_SECONDS=300
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200
# USD per 1M tokens for evaluation cost estimates: model=input/output,...
LLM_PRICING=claude-sonnet-5-5=3/15

# --- RAG / embeddings --------------------------------------------------------
EMBEDDING_PROVIDER=ollama             # ollama | none (keyword-only retrieval)
EMBEDDING_MODEL=nomic-embed-text
# Qdrant server URL; unset => embedded on-disk Qdrant at QDRANT_PATH (single process)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=trace_security_knowledge
RAG_TOP_K=6

# --- Scanners ----------------------------------------------------------------
# Binaries are resolved from TOOLS_DIR (./.tools/bin via scripts/install-tools.sh), then PATH.
GIT_PATH=git
TRIVY_PATH=trivy
SEMGREP_PATH=semgrep
GITLEAKS_PATH=gitleaks
OSV_SCANNER_PATH=osv-scanner
SCANNER_TIMEOUT=600
SCANNER_MEMORY_LIMIT_MB=4096          # enforced on Linux (RLIMIT_DATA)
SCANNER_OFFLINE=false                 # true: trivy/osv use local DBs only
SEMGREP_CONFIG=p/default              # or a local rules directory for offline use
MAX_REPO_SIZE_MB=500

# --- Vulnerability intelligence ---------------------------------------------
NVD_API_KEY=                          # raises NVD limit from 5 to 50 requests / 30s
INTEL_CACHE_TTL_HOURS=24

# --- MCP ---------------------------------------------------------------------
MCP_TOOL_TIMEOUT=120

# --- Remediation -------------------------------------------------------------
REMEDIATION_PR_BRANCH_PREFIX=trace/fix-

# --- Observability (optional; env fallback, per-org in Settings -> Integrations)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Demo / seed -------------------------------------------------------------
SEED_DEMO_DATA=true                   # creates admin + scans the bundled vulnerable fixture (labeled DEMO)
DEMO_ADMIN_EMAIL=admin@trace.example
DEMO_ADMIN_PASSWORD=trace-admin    # change outside local development

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
