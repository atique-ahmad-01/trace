# TRACE API on Oracle Cloud. Copy to .env next to docker-compose.yml; never commit it.

# Public hostname of the API. Point a DNS A record at the VM's public IP before the first start,
# so Caddy can get the Let's Encrypt certificate.
API_DOMAIN=api.trace-psi.me

# Shared Neon Postgres (same value as the Vercel project). Migrations run at startup.
DATABASE_URL=

# Same values as on Vercel, so sessions and stored credentials stay valid.
SECRET_KEY=
JWT_SECRET_KEY=

FRONTEND_URL=https://trace-psi.me
CORS_ORIGINS=https://trace-psi.me,https://www.trace-psi.me,https://trace-psi-gules.vercel.app,https://trace-atique-ahmad-chs-projects.vercel.app
CORS_ORIGIN_REGEX=^https://trace(-[a-z0-9-]+)?-atique-ahmad-chs-projects\.vercel\.app$

# Seeded admin and demo fixture. 12+ characters and not the default, or seeding is skipped.
SEED_DEMO_DATA=true
DEMO_VIEWER_ON_REGISTER=true
DEMO_ADMIN_EMAIL=admin@trace.example
DEMO_ADMIN_PASSWORD=

# Optional: verification emails.
# SMTP_HOST=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
